{"cells":[{"cell_type":"code","source":["from transformers import MarianMTModel, MarianTokenizer\n","\n","# Language dictionary (mapping language names to codes)\n","language_dict = {\n","    \"English\": \"en\",\n","    \"Spanish\": \"es\",\n","    \"French\": \"fr\",\n","    \"German\": \"de\",\n","    \"Italian\": \"it\",\n","    \"Portuguese\": \"pt\",\n","    \"Dutch\": \"nl\",\n","    \"Russian\": \"ru\",\n","    \"Chinese\": \"zh\",\n","    \"Japanese\": \"ja\",\n","    \"Arabic\": \"ar\",\n","    \"Hindi\": \"hi\",\n","    \"Bengali\": \"bn\",\n","    \"Korean\": \"ko\",\n","    \"Turkish\": \"tr\",\n","    \"Polish\": \"pl\"\n","}\n","\n","# Load MarianMT model and tokenizer\n","def load_model(source_lang, target_lang):\n","    model_name = f'Helsinki-NLP/opus-mt-{language_dict[source_lang]}-{language_dict[target_lang]}'\n","    model = MarianMTModel.from_pretrained(model_name)\n","    tokenizer = MarianTokenizer.from_pretrained(model_name)\n","    return model, tokenizer\n","\n","# Translate the input text\n","def translate_text(model, tokenizer, text):\n","    # Tokenize the text\n","    tokens = tokenizer.encode(text, return_tensors=\"pt\", truncation=True)\n","    # Translate the text\n","    translated_tokens = model.generate(tokens, max_length=512, num_beams=4, early_stopping=True)\n","    # Decode the translated tokens\n","    translated_text = tokenizer.decode(translated_tokens[0], skip_special_tokens=True)\n","    return translated_text\n","\n","# Google Colab input handling\n","from google.colab import widgets\n","\n","def colab_translate():\n","    print(\"AI Powered Multi-Language Translator\")\n","    input_text = input(\"Enter text to translate: \")\n","    source_language = input(\"Enter source language: \")\n","    target_language = input(\"Enter target language: \")\n","\n","    if source_language in language_dict and target_language in language_dict:\n","        model, tokenizer = load_model(source_language, target_language)\n","        translated_text = translate_text(model, tokenizer, input_text)\n","        print(\"Translated Text:\", translated_text)\n","    else:\n","        print(\"Invalid language selection. Please enter a valid language from the list.\")\n","\n","# Run the translation function\n","if __name__ == \"__main__\":\n","    colab_translate()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":360,"referenced_widgets":["f45ec7cf94564a278cf7fc68c35030e5","b22bb95cada240589fca0b2a1dbfe90a","cbcd3b7369044d42b0b2d903e59a5b5a","59ebcdb3329b4585a0383979a950cab2","caf7731b0ca84c80b0b563e3c821f873","0d5565359abf4c5c8f588ba3ed202b65","9bcc0d0d27aa4a259fc9ba9a569fb237","75b411d13c2048789fce9976277a2b3e","f66673f926a344b495c255121559a88a","11bfdbe1e82749bdb1e1f43f417a1630","27ebd68a7cf34f32b1be4a160814758f","5168eb2a550647e2b182ee4a4e9139bd","dc433fdcfb27429cbe7445d79996f679","d3061de6a76c4fbca0c66048f8f04840","774fb264f1224c658f5bf2c55709fc6e","45bb9b82415d4918b3b95ae3341b7b0c","b7e083aca0f14d7e85f6861eea770681","c6d34604e355475bb622c0fe19c7ed71","da2fcec341b446a188bb1636006af6f4","54f64e4d293f4eaeb079374f200c3e71","495ba68dd4334674a0c7e2f29de593e5","a4640314668c4862bb37817fd005bfa0","a2e17726dbbc4cd5b124d32b55506718","03c449a6e83346a69c833fd7ab452aed","9676acef44b644769369cfd86a13abb6","b2865181e25f4bb284efbc62360d338a","e0e7fc6936a64ab5b6b2d76619b60c0c","d09b1fe3a3244b8394ccfedf613b589d","b1d42fd7e174458088614ed69a26ed24","7baa3759ab994aecbf9f29f603cb4909","14ddbcc0462243e5a44ad474c66d0676","4321f72147e14ae7bb5861c17cad3bb3","bf61c9543b934b758f944e10c95230af","31799c4f716b4696b28f8dca6748acca","a9ade9368d144e73a9c5b04d41b7ee95","f898976cdea94ee4959a4d199fb1d390","648d75d123f2407fa18ee78649898d74","f4c9f306f58e46e08fcf6e711d3d4450","477b238e017a4b1cb248df2b8a1ca958","286d63e9ebb7407eb6b6c7efbe5d652d","0c41a2caa9164cb194cd5e295bee79da","82bb52f53642422da39f2b93506b6b5f","5982676c4eb5480e9c69bd59e014f648","b5c68713f0bd4aeba997ec74bf953442","f7d81fa8ef17445b8c9a0ac74648935f","